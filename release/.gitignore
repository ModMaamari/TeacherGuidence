# SFT train/dev files: large and rebuilt deterministically from data/episodes
# with `make data` (~2 min; scripts/build_splits.py). The test question files,
# the pool assignment, the stats and the leakage report ARE tracked.
data/splits/uniform/train.jsonl
data/splits/uniform/dev.jsonl
data/splits/lodo/*/train.jsonl
data/splits/lodo/*/dev.jsonl
